  {
    "start": 1142.14,
    "end": 1144.14,
    "text": "大豬起的扛虧損能力很強"
  },
  {
    "start": 1144.14,
    "end": 1145.14,
    "text": "所以中上面的說"
  },
  {
    "start": 1145.14,
    "end": 1147.34,
    "text": "受到異病"
  },
  {
    "start": 1147.34,
    "end": 1151.46,
    "text": "政治虧損去產能這一輪的這個影響"
  },
  {
    "start": 1151.46,
    "end": 1153.46,
    "text": "相較於前幾輪全部做花了"
  },
  {
    "start": 1153.46,
    "end": 1157.98,
    "text": "所以導致了本一輪週期的長期模擬"
  },
  {
    "start": 1157.98,
    "end": 1158.98,
    "text": "好了"
  },
  {
    "start": 1158.98,
    "end": 1162.98,
    "text": "這個是我第一輪關於這個"
  },
  {
    "start": 1162.98,
    "end": 1164.98,
    "text": "第一個視頻關於週期的這個"
  },
  {
    "start": 1164.98,
    "end": 1166.98,
    "text": "研究影響"
  },
  {
    "start": 1166.98,
    "end": 1171.23,
    "text": "當時我的一些基本面研究的東西"
  },
  {
    "start": 1171.23,
    "end": 1172.23,
    "text": "分享給大家"
  },
  {
    "start": 1172.23,
    "end": 1174.23,
    "text": "如果大家感興趣的話"
  },
  {
    "start": 1174.23,
    "end": 1175.23,
    "text": "可以關注我"
  },
  {
    "start": 1175.23,
    "end": 1179.36,
    "text": "給我的評論區點贊投幣"
  },
  {
    "start": 1179.36,
    "end": 1180.36,
    "text": "或者留言"
  },
  {
    "start": 1180.36,
    "end": 1184.9,
    "text": "我會逐漸的來解答大家的問題"
  },
  {
    "start": 1184.9,
    "end": 1187.9,
    "text": "下一期視頻我們開始講"
  },
  {
    "start": 1187.9,
    "end": 1190.9,
    "text": "這個豬週期到底進行到了哪一個階段"
  },
  {
    "start": 1190.9,
    "end": 1192.9,
    "text": "好了謝謝大家"
  },
  {
    "start": 1192.9,
    "end": 1194.9,
    "text": "這一個視頻結束了"
  },
  {
    "start": 1194.9,
    "end": 1195.9,
    "text": "再見"
  }
]