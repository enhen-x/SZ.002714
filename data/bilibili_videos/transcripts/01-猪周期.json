  {
    "start": 1034.91,
    "end": 1036.91,
    "text": "這個驅動產能的因素"
  },
  {
    "start": 1036.91,
    "end": 1038.91,
    "text": "非常的弱"
  },
  {
    "start": 1038.91,
    "end": 1039.91,
    "text": "首先我們講這個"
  },
  {
    "start": 1039.91,
    "end": 1040.91,
    "text": "從政策端來看"
