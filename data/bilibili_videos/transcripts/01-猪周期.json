  {
    "start": 908.27,
    "end": 910.27,
    "text": "為什麼明顯的不一樣"
  },
  {
    "start": 910.27,
    "end": 913.56,
    "text": "我總結來說是三個原因"
  },
  {
    "start": 913.56,
    "end": 916.04,
    "text": "這個是個人的一點前面"
  },
  {
    "start": 916.04,
    "end": 918.04,
    "text": "第一個原因是什麼呢"
  },
  {
    "start": 918.04,
    "end": 919.04,
    "text": "本輪的集團場"
  },
  {
    "start": 919.04,
    "end": 921.04,
    "text": "主導了市場的格局"
  },
  {
    "start": 921.04,
    "end": 923.04,
    "text": "集團場的增產能是非常的快的"
  },
  {
    "start": 923.04,
    "end": 926.04,
    "text": "讓他們資金量雄厚"
  },
  {
    "start": 926.04,
    "end": 928.52,
    "text": "他們去產能的速度是非常慢的"
  },
  {
    "start": 928.52,
    "end": 930.52,
    "text": "因為集團場的投入成本高"
  },
  {
    "start": 930.52,
    "end": 932.52,
    "text": "退出的成本太高了"
  },
  {
    "start": 932.52,
    "end": 934.52,
    "text": "他們維持高產能"
  },
  {
    "start": 934.52,
    "end": 936.52,
    "text": "能夠壓低他們的單位固定成本"
  },
  {
    "start": 936.52,
    "end": 937.52,
    "text": "同時集團場"
  },
  {
    "start": 937.52,
    "end": 939.52,
    "text": "大多數都是上市公司"
  },
  {
    "start": 939.52,
    "end": 941.87,
    "text": "它中資能力強"
  },
  {
    "start": 941.87,
    "end": 943.87,
    "text": "能夠在低租價的時候"
  },
  {
    "start": 943.87,
    "end": 947.51,
    "text": "長期保持經營狀態"
  },
  {
    "start": 947.51,
    "end": 949.51,
    "text": "同時它維持低租價"
  },
  {
    "start": 949.51,
    "end": 951.51,
    "text": "還可以導致散貨大量的"
  },
  {
    "start": 951.51,
    "end": 953.51,
    "text": "退出這個行業"
  },
  {
    "start": 953.51,
    "end": 955.18,
    "text": "這樣的話"
  },
  {
    "start": 955.18,
    "end": 957.18,
    "text": "他們就可以佔據這些市場份額"
  },
  {
    "start": 957.18,
    "end": 959.18,
    "text": "基於這幾種因素的考慮的話"
  },
  {
    "start": 959.18,
    "end": 962.18,
    "text": "集團場不會輕易地去產能"
  },
  {
    "start": 962.18,
    "end": 963.18,
    "text": "它就會導致"
  },
  {
    "start": 963.18,
    "end": 966.18,
    "text": "現在變成集團場主導了之後"
  },
  {
    "start": 966.18,
    "end": 969.18,
    "text": "整體的產能的缺乏週期變慢"
  },
  {
    "start": 969.18,
    "end": 972.18,
    "text": "駐價在底部的模底的時間"
  },
  {
    "start": 972.18,
    "end": 973.18,
    "text": "大大的被延長"
  },
  {
    "start": 973.18,
    "end": 975.18,
    "text": "從集團場用特性來說"
  },
  {
    "start": 975.18,
    "end": 978.18,
    "text": "最好的週期發展的信號"
  },
  {
    "start": 978.18,
    "end": 981.18,
    "text": "實際上是集團場的大面積爆雷"
  },
